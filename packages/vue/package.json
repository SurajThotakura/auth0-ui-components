{
  "name": "@auth0/universal-components-vue",
  "version": "1.0.0-beta.1",
  "private": false,
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./proxy": {
      "types": "./dist/proxy.d.ts",
      "import": "./dist/proxy.mjs",
      "require": "./dist/proxy.js"
    },
    "./styles": "./dist/styles.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "build:css": "npx @tailwindcss/cli -i ./src/styles/globals.css -o ./dist/styles.css --minify",
    "type-check": "vue-tsc --noEmit",
    "build:ts": "tsup",
    "build:dts": "vue-tsc --declaration --emitDeclarationOnly --outDir dist",
    "build": "pnpm clean && pnpm type-check && pnpm build:ts",
    "dev": "tsup --watch",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "registry:build": "shadcn-vue build -o ../../docs-site/public/r"
  },
  "peerDependencies": {
    "vue": "^3.5.0",
    "@auth0/auth0-vue": "^2.5.0"
  },
  "peerDependenciesMeta": {
    "@auth0/auth0-vue": {
      "optional": true
    }
  },
  "dependencies": {
    "@auth0/universal-components-core": "1.0.0-beta.7",
    "@tanstack/vue-query": "^5.56.2",
    "@vee-validate/zod": "^4.15.0",
    "@vueuse/core": "^12.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-vue-next": "^0.511.0",
    "reka-ui": "^2.1.0",
    "tailwind-merge": "^3.3.0",
    "vee-validate": "^4.15.0",
    "vue-sonner": "^2.0.0",
    "zod": "^3.25.56"
  },
  "author": "Auth0",
  "license": "MIT",
  "devDependencies": {
    "@auth0/auth0-vue": "^2.5.0",
    "@tailwindcss/cli": "^4.1.17",
    "@tailwindcss/postcss": "^4.1.10",
    "@testing-library/vue": "^8.1.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "@vue/test-utils": "^2.4.6",
    "postcss": "^8.5.6",
    "rimraf": "^5.0.0",
    "tailwindcss": "^4.1.10",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "unplugin-vue": "^5.2.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0",
    "vue": "^3.5.0",
    "vue-tsc": "^2.2.0"
  }
}
