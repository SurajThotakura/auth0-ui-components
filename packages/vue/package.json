{
  "name": "@auth0/universal-components-vue",
  "version": "1.0.0-beta.7",
  "private": false,
  "sideEffects": [
    "*.css"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./styles": "./dist/styles.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "build:css": "npx @tailwindcss/cli -i ./src/styles/globals.css -o ./dist/styles.css --minify",
    "type-check": "vue-tsc --noEmit",
    "build:ts": "tsup",
    "build": "pnpm clean && pnpm type-check && pnpm build:ts && pnpm build:css",
    "dev": "tsup --watch",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .vue,.ts,.tsx"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "dependencies": {
    "@auth0/universal-components-core": "workspace:*",
    "@tanstack/vue-query": "^5.56.2",
    "@vueuse/core": "^10.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-vue-next": "^0.511.0",
    "radix-vue": "^1.9.0",
    "tailwind-merge": "^3.3.0",
    "zod": "^3.25.56"
  },
  "author": "Auth0",
  "license": "MIT",
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.17",
    "@tailwindcss/postcss": "^4.1.10",
    "@testing-library/vue": "^8.1.0",
    "@vitejs/plugin-vue": "^5.1.0",
    "@vue/test-utils": "^2.4.6",
    "eslint-plugin-vue": "^9.27.0",
    "postcss": "^8.5.6",
    "rimraf": "^5.0.0",
    "tailwindcss": "^4.1.10",
    "typescript": "^5.9.0-beta",
    "vue": "^3.4.0",
    "vue-tsc": "^2.0.0"
  }
}
